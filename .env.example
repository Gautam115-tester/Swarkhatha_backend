# Server
PORT=8080
BASE_URL=https://your-backend.onrender.com
JWT_SECRET=replace-with-a-long-random-string   # openssl rand -hex 48
TOKEN_ENC_KEY=replace-with-64-hex-chars   # openssl rand -hex 32

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Storage: Drime Cloud
#
# Unlike the old MediaFire setup, Drime needs NO app-wide credentials
# here at all — each pooled storage account is added purely through the
# API (POST /api/storage/accounts) after deploy, using a personal access
# token generated from that Drime account's own dashboard
# (Account Settings -> Developers -> Create a token). Tokens are
# encrypted at rest with TOKEN_ENC_KEY above before being stored — see
# README.md and DEPLOYMENT.md.
#
# Optional: override the Drime API base URL (rarely needed).
# DRIME_API_BASE=https://app.drime.cloud/api/v1

# Optional: how long the short-lived signed URLs behind stream-url /
# download-url stay valid, in seconds (default 900 = 15 minutes).
# STREAM_TOKEN_TTL_SECONDS=900

# Optional: how often (ms) the backend polls each Drime account in the
# background for the live storage dashboard (default 8000).
# Drime disk-space checks (lib/liveAccountsMonitor.js)
# While an admin app is open (SSE stream connected or polling GET /accounts):
# STORAGE_REFRESH_INTERVAL_MS=30000
# While no admin app is open (in-process timer; only runs while the instance is awake):
# STORAGE_BACKGROUND_INTERVAL_MS=1500000
# Shared secret for POST /api/storage/accounts/background-check — needed for the
# Render-free-tier external scheduler (cdn-worker/storage-check-cron-worker.js).
# Unset = that route returns 404.
# STORAGE_CRON_SECRET=

# --- Image loading performance (see IMAGE_PERFORMANCE.md) ---

# Optional: max bytes held in the in-memory cover-image cache
# (lib/imageCache.js). Default 200MB. Render's free instances have
# limited RAM, so don't set this above what your instance actually has
# to spare.
# IMAGE_CACHE_MAX_BYTES=209715200

# Optional: how long (ms) a storage_accounts row is cached in memory
# before re-checking Supabase (lib/accountCache.js). Default 5 minutes.
# STORAGE_ACCOUNT_CACHE_TTL_MS=300000

# Optional: if you put a CDN/edge cache in front of the cover-image
# route (see cdn-worker/), set this to that CDN's URL. Newly-uploaded
# covers will use it automatically; run
# scripts/repoint-cover-urls-to-cdn.js once to update older covers too.
# Leave unset to keep serving covers straight from this backend.
# IMAGE_CDN_BASE_URL=https://swarkatha-covers.your-subdomain.workers.dev

# --- Password reset emails (routes/auth.js: /forgot-password) ---
#
# Any standard SMTP provider works (SendGrid, Resend, Mailgun, Gmail with an
# app password, etc.) -- nothing provider-specific is assumed. If these are
# left unset, reset codes are just logged to the server console instead of
# emailed, which is fine for local dev/testing but NOT for production.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_smtp_password_or_api_key
# SMTP_FROM=SwarKatha <no-reply@yourdomain.com>

# --- Manual subscriptions (routes/subscriptions.js, lib/subscription.js) ---
#
# Calendar day used for "today" when working out status / remaining days and
# when the expiry reminders fire. Default Asia/Kolkata. Any IANA zone name.
# SUBSCRIPTION_TZ=Asia/Kolkata
#
# Shared secret for POST /api/subscriptions/cron/run -- lets an external
# scheduler send expiry reminders (in-app + email) even while the Render
# instance is asleep. Unset = that route returns 404. Sent as the
# x-cron-secret header. Generate e.g. with: openssl rand -hex 32
# SUBSCRIPTION_CRON_SECRET=
#
# How often (ms) the in-process sweep runs while the instance is awake
# (default 3600000 = hourly).
# SUBSCRIPTION_CHECK_INTERVAL_MS=3600000
# Reminder emails reuse the SMTP_* settings above (logged to the console if unset).

# --- Free trial, device limits, enforcement (see SUBSCRIPTIONS_TRIALS_DEVICES.md) ---
#
# Server-side gates. Both default to "on". Set to "off" ONLY for a staged
# rollout (e.g. while old app builds without device support are still in use).
# SUBSCRIPTION_ENFORCEMENT=on   # stream-url / download-url / stream / file need a valid plan or running trial
# DEVICE_ENFORCEMENT=on         # listeners must sign in from a registered, un-blocked device within their limit
#
# Secret used to hash device identifiers before they are stored (HMAC). Falls
# back to TOKEN_ENC_KEY if unset. NEVER change it once devices are registered:
# every stored device would stop matching and look like a brand-new phone.
# DEVICE_HASH_SECRET=
#
# How the backend treats Dual Apps / app-cloner containers:
#   dedupe          (default) OS Dual Apps / second user are folded onto the original phone
#   block_virtual   also REFUSE login from third-party cloner sandboxes
#   block_all       refuse ANY secondary-user / dual-app / cloned environment
# CLONE_POLICY=dedupe
#
# Also stop one physical phone from claiming trials under several emails
# (default off: the rule is one trial per email).
# TRIAL_BLOCK_REUSED_DEVICE=off
#
# Hours the app may keep playing DOWNLOADED files without re-checking with the
# server (it cannot ask while offline). Default 72.
# OFFLINE_GRACE_HOURS=72
#
# Seconds-level caches so the checks are not a database hit on every request.
# Admin changes take effect immediately on this instance; the TTL bounds the
# delay across several instances.
# DEVICE_CHECK_TTL_MS=15000
# ENTITLEMENT_CACHE_TTL_MS=10000

# ---------------------------------------------------------------------------
# Automatic music classification (see CLASSIFICATION.md). Everything below is
# OPTIONAL: with none of it set the system still runs using title/version rules,
# the existing category label, cached lyrics and the Groq pool you already have.
# ---------------------------------------------------------------------------
# CLASSIFICATION_ENABLED=on                 # off = no queuing; music falls back to the old Groq categorizer
# CLASSIFICATION_WORKER_ENABLED=on          # off if a separate `npm run classification -- worker` process does the work
# CLASSIFICATION_LOG_LEVEL=info             # info | warn | error | silent
# CLASSIFICATION_CRON_SECRET=               # enables POST /api/classification/cron/run (x-cron-secret header) for sleeping hosts
# CLASSIFICATION_CONCURRENCY=2
# CLASSIFICATION_POLL_MS=5000
# CLASSIFICATION_MAX_ATTEMPTS=5
# CLASSIFICATION_JOB_TIMEOUT_MS=120000
# CLASSIFICATION_BACKFILL_BATCH=50          # 1-100
# CLASSIFY_REQUIRED_DIMENSIONS=genre,language,vocal,version
# CLASSIFY_THRESHOLD_APPROVE=0.95           # >= auto-approve
# CLASSIFY_THRESHOLD_SUPPORTED=0.85         # >= approve if 2+ independent sources (or title/lyrics rules)
# CLASSIFY_THRESHOLD_PROVISIONAL=0.70
# CLASSIFY_THRESHOLD_REVIEW=0.50            # below this a candidate is not stored
# MUSICBRAINZ_CONTACT=you@example.com       # REQUIRED to enable MusicBrainz (its policy needs a contact in the User-Agent)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# LASTFM_API_KEY=
# CLASSIFY_LLM_ENABLED=on                   # text-only Groq inference (title/artist/album), weak evidence
# AUDIO_ANALYSIS_ENABLED=false              # audio analyzer adapter: needs ALL THREE of these
# AUDIO_ANALYSIS_CONSENT=false
# AUDIO_ANALYZER_URL=                       # a service YOU run; receives a short-lived stream link, see CLASSIFICATION.md
# AUDIO_ANALYZER_TOKEN=
